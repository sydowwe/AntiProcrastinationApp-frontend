VITE_API_URL=https://localhost:8080
VITE_APP_URL=https://localhost:3000
# Web Push VAPID public key. The framework's UsePushNotifications reads it from here instead of
# fetching GET /push/vapid-public-key the way this app's own composable used to. Leave empty to
# disable push subscription locally — subscribe() logs and returns false rather than throwing.
VITE_VAPID_PUBLIC_KEY=

# reCAPTCHA v3 site key. Leave empty locally: `executeRecaptcha()` then warns once and resolves to an
# empty token instead of blocking the submit, so sign-in works against a local API that does not
# enforce one. Before 2026-09-13 this key was simply absent, and `load(undefined)` never settled —
# the Log in button fired no request, logged nothing and showed no validation error, which reads as a
# broken locator rather than a missing key. See `src/_common/docs/composables.md`.
VITE_RECAPTCHA_SITE_KEY=
