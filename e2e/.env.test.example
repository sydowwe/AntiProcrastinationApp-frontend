# Where the app under test and its API live. E2E_API_URL must match VITE_API_URL in ../.env.development.
E2E_API_URL=https://localhost:8080
E2E_BASE_URL=https://localhost:3000

# There are no credentials here on purpose. POST /api/test/seed creates the two e2e accounts and echoes
# their email and password back in its response; the specs read them off the `seed` fixture. A second
# copy in this file is free to drift from the seeder, and the account cannot be created any other way —
# `testpass123` does not satisfy the API's own registration policy, so the seeder writes the hash direct.
